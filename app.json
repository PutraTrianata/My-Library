{
  "expo": {
    "name": "SIPADU PGRI 2",
    "slug": "verdant-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon.png",
    "splash": {
      "backgroundColor": "#F5F1E8"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#FFFFFF",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.nazwazahira14.mylibrary"
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "publicPath": "/CrossPlatAPP/"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "5fba8c45-8330-404f-a6fa-997378063b4b"
      }
    }
  }
}