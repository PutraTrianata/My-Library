{
  "expo": {
    "name": "MyLibrary",
    "slug": "verdant-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F5F1E8"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
  "backgroundColor": "#FFFFFF",
  "adaptiveIcon": {
    "backgroundColor": "#F5F1E8"
  }
},
"androidStatusBar": {
  "backgroundColor": "#FFFFFF",
  "barStyle": "dark-content",
  "translucent": false
},
    "web": {
      "bundler": "metro",
      "publicPath": "/CrossPlatAPP/"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
